# Optional remote decision models. Omit this setting to keep decisions off.
CODEGRAPH_DECISIONS=auto
JEV_API_KEY=your_jev_api_key

# Optional hosted Clef / Clef-flash; omit these to use JEV only.
# Scope the token to this account with Workers AI inference access and
# Account > Account Analytics > Read. Free allowance is queried automatically.
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_workers_ai_and_analytics_token

# D1 sends user prompts remotely only with this explicit opt-in.
CODEGRAPH_DECISION_ALLOW_REMOTE_PROMPTS=0

# Optional: use the same absolute quota DB path across local processes.
# CODEGRAPH_CF_USAGE_DB=/absolute/path/to/decision-usage.sqlite
# Optional: log selected models and usage-check results, without prompt content.
# CODEGRAPH_DECISION_LEDGER=/absolute/path/to/decision-ledger.jsonl
